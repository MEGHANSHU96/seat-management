#!/bin/bash
APP_DIR="{{ app_directory }}"
JAR_FILE="$APP_DIR/{{ jar_dest_name }}"
PID_FILE="$APP_DIR/app.pid"
LOG_FILE="$APP_DIR/logs/seat-api.log"

start() {
    if [ -f "$PID_FILE" ] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
        echo "Seat API already running with PID $(cat $PID_FILE)"
        exit 0
    fi
    nohup java -jar "$JAR_FILE" --server.port={{ app_port }} > "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    echo "Started Seat API with PID $(cat $PID_FILE)"
}

stop() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if kill -0 "$PID" 2>/dev/null; then
            kill "$PID"
            sleep 2
        fi
        rm -f "$PID_FILE"
    fi
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
